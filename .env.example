# Copy to .env on the server and chmod 600. Never commit the real file.

# --- required ---
POSTGRES_PASSWORD=change-me
DATABASE_URL=postgres://weather:change-me@postgres:5432/weather?sslmode=disable

# --- image tag: set by `make deploy TAG=<sha>`; defaults to latest ---
TAG=latest

# --- optional, defaults shown ---
# PORT=8080
# LOG_LEVEL=info
# JMA_BASE_URL=https://www.jma.go.jp
# JMA_TIMEOUT=30s
# POLL_INTERVAL=5m
# RETENTION_DAYS=30
# MAX_STATION_DISTANCE_KM=100
# STALENESS_THRESHOLD=30m

# --- backups (rclone -> Cloudflare R2) ---
# These are R2 *S3 access keys* (R2 > API > Manage API tokens), NOT the
# Cloudflare API token Terraform uses. backup.sh configures rclone from these,
# so there is no rclone.conf on the box.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=tenkinow-backups

# Hostname this box serves. api.tenkinow.com on the Singapore origin,
# api-tokyo.tenkinow.com on the Tokyo one; Caddy reads it as the site address.
API_HOSTNAME=api.tenkinow.com
