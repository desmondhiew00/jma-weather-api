# Where the site sends its API requests. Leave unset to use the deployed API.
# The Go service in this repo listens on 8080 by default.
PUBLIC_API_BASE=http://localhost:8080

# Google Maps JavaScript API key, used by the map page. Read at build time and
# embedded in the page. A Maps JS key is always visible to the browser, so
# restrict it by HTTP referrer in the Google Cloud console rather than relying
# on it staying secret.
GOOGLE_MAP_API=
